{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2023"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "out/autoupdate",
    "rootDir": "src/setup-launcher"
  },
  "include": ["src/setup-launcher/autoupdate.ts", "src/setup-launcher/autoupdate-shared.ts"]
}